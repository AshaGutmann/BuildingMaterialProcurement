# ========================================
# Blockchain Network Configuration
# ========================================

# Sepolia Testnet RPC URL
# Get from: https://infura.io/ or https://alchemy.com/
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR-PROJECT-ID

# Deployer Private Key (must have Sepolia ETH)
# Get testnet ETH from: https://sepoliafaucet.com/
PRIVATE_KEY=your-private-key-here

# Network Chain ID (11155111 for Sepolia)
CHAIN_ID=11155111


# ========================================
# Smart Contract Configuration
# ========================================

# Deployed Contract Address (update after deployment)
VITE_CONTRACT_ADDRESS=0x...

# Contract Owner Address (should match deployer address)
CONTRACT_OWNER=0x...

# Procurement Duration (in seconds, default: 7 days)
PROCUREMENT_DURATION=604800


# ========================================
# Etherscan Configuration
# ========================================

# Etherscan API Key for contract verification
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your-etherscan-api-key


# ========================================
# WalletConnect Configuration
# ========================================

# WalletConnect Project ID (required for RainbowKit)
# Get from: https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id


# ========================================
# Gas Reporting Configuration
# ========================================

# Enable gas reporting in tests
REPORT_GAS=true

# CoinMarketCap API Key for gas price in USD
# Get from: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key


# ========================================
# CI/CD Configuration
# ========================================

# Codecov Upload Token
# Get from: https://codecov.io/
CODECOV_TOKEN=your-codecov-token


# ========================================
# Pauser Configuration (Optional)
# ========================================

# Pauser Address (authorized to pause contract in emergencies)
PAUSER_ADDRESS=0x...

# Pauser Private Key (keep secure, used for emergency actions)
PAUSER_PRIVATE_KEY=your-pauser-private-key

# Emergency Contact Email
EMERGENCY_CONTACT_EMAIL=security@example.com

# Pause Notification Webhook (optional, for alerting)
PAUSE_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL


# ========================================
# FHE Oracle Configuration
# ========================================

# FHE Decryption Gateway URL
# Default for Sepolia: https://gateway.sepolia.zama.ai/
FHE_GATEWAY_URL=https://gateway.sepolia.zama.ai/

# FHE ACL Contract Address (Sepolia)
FHE_ACL_ADDRESS=0x...

# FHE KMS Verifier Contract Address (Sepolia)
FHE_KMS_VERIFIER_ADDRESS=0x...


# ========================================
# Frontend Configuration
# ========================================

# Application Name
VITE_APP_NAME=Secure Procurement Platform

# Application URL (for production)
VITE_APP_URL=https://your-username.github.io/secure-procurement

# Enable debug mode in development
VITE_DEBUG=false

# Toast notification duration (milliseconds)
VITE_TOAST_DURATION=5000


# ========================================
# Testing Configuration
# ========================================

# Run tests on Sepolia (true/false)
RUN_SEPOLIA_TESTS=false

# Test timeout (milliseconds)
TEST_TIMEOUT=60000

# Enable verbose test output
VERBOSE_TESTS=false


# ========================================
# Performance Monitoring
# ========================================

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=false

# Lighthouse CI token (optional)
LIGHTHOUSE_TOKEN=your-lighthouse-token


# ========================================
# Logging Configuration
# ========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable console logging in production
ENABLE_CONSOLE_LOGS=false


# ========================================
# Rate Limiting Configuration
# ========================================

# Maximum requests per minute
RATE_LIMIT_RPM=60

# Cooldown period between bids (seconds)
BID_COOLDOWN=60


# ========================================
# Security Configuration
# ========================================

# Enable security headers
ENABLE_SECURITY_HEADERS=true

# Content Security Policy (CSP)
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';

# Enable CORS (for development)
ENABLE_CORS=true
