{
  "name": "secure-procurement",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:unit": "npx hardhat test test/SecureProcurement.test.ts",
    "test:sepolia": "npx hardhat test test/SecureProcurementSepolia.test.ts --network sepolia",
    "test:gas": "REPORT_GAS=true npx hardhat test",
    "test:coverage": "npx hardhat coverage",
    "deploy": "npx hardhat run scripts/deploy.js --network sepolia",
    "deploy:local": "npx hardhat run scripts/deploy.js --network hardhat",
    "clean": "npx hardhat clean",
    "verify": "npx hardhat verify --network sepolia",
    "lint": "npm run lint:sol && npm run lint:ts",
    "lint:sol": "solhint 'contracts/**/*.sol' -o solhint-report.txt",
    "lint:ts": "eslint 'src/**/*.ts' 'test/**/*.ts' --max-warnings 0",
    "lint:fix": "npm run lint:sol:fix && npm run lint:ts:fix",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix",
    "lint:ts:fix": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'contracts/**/*.sol' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'contracts/**/*.sol' 'test/**/*.ts'",
    "security": "npm audit --production && npm run lint && npm run type-check",
    "security:audit": "npm audit --production --audit-level=moderate",
    "security:fix": "npm audit fix",
    "analyze": "npm run build -- --mode analyze",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fhevm/solidity": "^0.8.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@zama-fhe/oracle-solidity": "^0.2.0",
    "autoprefixer": "^10.4.21",
    "chai": "^4.4.1",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^2.0.2",
    "husky": "^9.0.11",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "solhint": "^4.5.4",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.5",
    "tailwindcss": "^4.1.14",
    "terser": "^5.28.0",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-compression": "^0.5.1"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.2.1",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/react-query": "^5.90.5",
    "ethers": "^6.15.0",
    "fhevmjs": "^0.6.2",
    "viem": "^2.38.3",
    "wagmi": "^2.18.1"
  }
}
