#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

# Run all tests including coverage
echo "🧪 Running full test suite with coverage..."
npm run test:coverage || {
  echo "❌ Tests failed. Please fix failing tests before pushing."
  exit 1
}

# Run security audit
echo "🔒 Running security audit..."
npm audit --production --audit-level=moderate || {
  echo "⚠️  Security vulnerabilities found. Review and fix before pushing."
  exit 1
}

# Compile contracts
echo "🔨 Compiling smart contracts..."
npm run compile || {
  echo "❌ Contract compilation failed. Please fix before pushing."
  exit 1
}

# Build check
echo "📦 Checking production build..."
npm run build || {
  echo "❌ Build failed. Please fix before pushing."
  exit 1
}

echo "✅ All pre-push checks passed!"
